{
  "name": "raneomik/nette-pwa",
  "description": "\uD83D\uDCF2 Nette PWA extension: web app manifest configured in NEON, service worker and Web Push",
  "keywords": [
    "nette-extension",
    "pwa",
    "manifest",
    "service-worker",
    "web-push",
    "notifications"
  ],
  "homepage": "https://github.com/raneomik/nette-pwa",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "nette/application": "^3.2",
    "nette/di": "^3.2",
    "nette/http": "^3.3",
    "nette/schema": "^1.4",
    "nette/utils": "^4.0"
  },
  "require-dev": {
    "infection/infection": "^0.35.8",
    "latte/latte": "^3.0",
    "minishlink/web-push": "^11.0",
    "nette/assets": "^1.0",
    "nette/bootstrap": "^3.2",
    "nette/database": "^3.2",
    "nette/security": "^3.2",
    "nette/tester": "^2.5",
    "nyholm/psr7": "^1.8",
    "phpro/grumphp": "^2.23",
    "phpstan/phpstan-nette": "^2.0",
    "raneomik/infection-tester-adapter": "^0.3.3",
    "rector/rector": "^2.8",
    "symfony/http-client": "^7.0",
    "symplify/easy-coding-standard": "^13.0",
    "tracy/tracy": "^2.10"
  },
  "suggest": {
    "minishlink/web-push": "Web Push (push: section), with ext-gmp for speed",
    "symfony/http-client": "Default PSR-18 client for Web Push (with nyholm/psr7)",
    "nette/database": "Default subscription storage",
    "nette/assets": "Versioned icon URLs in the manifest (src: 'img:icon')",
    "latte/latte": "{pwaHead()} function",
    "tracy/tracy": "PWA debug panel: manifest checks, service worker, pushes sent"
  },
  "autoload": {
    "psr-4": {
      "Raneomik\\NettePWA\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Raneomik\\NettePWA\\": "tests/"
    }
  },
  "extra": {
    "nette": {
      "di-extensions": {
        "pwa": {
          "class": "Raneomik\\NettePWA\\Bridge\\DI\\PWAExtension"
        }
      }
    }
  },
  "scripts": {
    "ci": [
      "@rector",
      "@ecs",
      "@phpstan",
      "@test"
    ],
    "complete": [
      "@ci",
      "@infection"
    ],
    "rector": "vendor/bin/rector",
    "ecs": "vendor/bin/ecs check --fix",
    "phpstan": "vendor/bin/phpstan analyse",
    "test": "vendor/bin/tester tests -s -C",
    "test-coverage": "vendor/bin/tester -s --coverage tests/reports/coverage.xml --coverage-src src -o junit:tests/reports/junit.xml tests",
    "test-htmlcoverage": "vendor/bin/tester -s -C --coverage tests/reports/coverage.html --coverage-src src tests",
    "infection": "vendor/bin/infection --threads=max --with-uncovered --show-mutations=0"
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true,
      "php-http/discovery": true,
      "phpro/grumphp": true
    }
  }
}
