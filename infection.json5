{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "testFramework": "tester",
    "source": {
        "directories": [
            "src"
        ],
    },
    "logs": {
        "text": "tests/reports/infection.log",
        "html": "tests/reports/infection.html",
        "summary": "tests/reports/infection-summary.log",
        "stryker": {
            "report": "main"
        }
    },
    "mutators": {
        "@default": true,
        // equivalent mutants: no observable behavior changes
        "AssignCoalesce": {
            // memoization only: the same JSON / SVG, computed again
            "ignore": [
                "Raneomik\\NettePWA\\Manifest\\ManifestProvider::getJson",
                "Raneomik\\NettePWA\\Bridge\\Tracy\\PWAPanel::svg",
            ],
        },
        "IncrementInteger": {
            "ignore": ["Raneomik\\NettePWA\\Bridge\\Tracy\\PWAPanel::svg"], // random_bytes(4): any length makes a unique id
        },
        "DecrementInteger": {
            "ignore": ["Raneomik\\NettePWA\\Bridge\\Tracy\\PWAPanel::svg"],
            "ignoreSourceCodeByRegex": ["\\$largest = 0;"], // -1 or 0: both below the 144 minimum
        },
    },
    "threads": "max",
    "timeout": 60,
}
