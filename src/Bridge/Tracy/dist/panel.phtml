			<div class="pwa-body">
				<?php if (null === $push): ?>
					<p class="pwa-muted">Not configured (pwa: push).</p>
				<?php else: ?>
					<dl class="pwa-config">
						<dt>Subscribe route</dt><dd><?= $e($baseUrl . ltrim($push['subscribePath'], '/')) ?></dd>
						<dt>VAPID subject</dt><dd><?= $e($push['subject']) ?></dd>
						<dt>Push services</dt><dd><?= $e(implode(', ', $push['pushServices'])) ?></dd>
					</dl>
					<?php $issues($data['push'], 'Configured.') ?>

					<?php if ([] === $data['sent']): ?>
						<p class="pwa-muted">Nothing sent since the last panel.</p>
					<?php else: ?>
						<ul class="pwa-sent">
							<?php foreach ($data['sent'] as $sent): ?>
								<li class="pwa-push<?= [] === $sent->failures ? '' : ' pwa-failed' ?>">
									<div class="pwa-push-title">
										<b><?= $e($sent->notification->title) ?></b>
										<small><?= number_format($sent->milliseconds, 1) ?> ms</small>
									</div>
									<?php if (null !== $sent->notification->body): ?><div><?= $e($sent->notification->body) ?></div><?php endif ?>
									<div class="pwa-meta">
										<?= $e(implode(', ', $sent->topics)) ?><?php if (null !== $sent->notification->url): ?>, opens <?= $e($sent->notification->url) ?><?php endif ?>
									</div>
									<div class="pwa-meta">
										<?php if (0 === $sent->recipients): ?>
											<span title="no subscription for these topics">0 recipients</span>
										<?php else: ?>
											<?= $sent->recipients ?> recipient<?= 1 === $sent->recipients ? '' : 's' ?> (<?= $e(implode(', ', $sent->locales)) ?>), <?= $sent->delivered ?> delivered<?php if ([] !== $sent->expired): ?>, <span title="<?= $e(implode(', ', $sent->expired)) ?>"><?= \count($sent->expired) ?> expired and removed</span><?php endif ?>
										<?php endif ?>
									</div>
									<?php foreach ($sent->failures as $failure): ?>
										<div class="pwa-meta pwa-failure"><?= $e($failure['service']) ?> <?= $e($failure['status'] ?? '–') ?>: <?= $e($failure['reason']) ?></div>
									<?php endforeach ?>
								</li>
							<?php endforeach ?>
						</ul>
					<?php endif ?>
				<?php endif ?>
			</div>
		</section>

	</div>
</div>
