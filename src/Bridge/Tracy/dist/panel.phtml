<?php declare(strict_types=1);

use Raneomik\NettePWA\Manifest\Value\Issue;
use Raneomik\NettePWA\Push\Debug\SentPush;
use Tracy\Helpers;

/**
 * @var array{manifest: list<Issue>, serviceWorker: list<Issue>, push: list<Issue>, sent: list<SentPush>} $data
 * @var string $baseUrl
 * @var string $serviceWorker
 * @var bool $customServiceWorker
 * @var ?array{publicKey: string, subject: string, pushServices: list<string>, subscribePath: string} $push
 * @var string $logo
 */

$e = static fn (mixed $value): string => Helpers::escapeHtml((string) $value);
$icons = [Issue::Error => '✖', Issue::Warning => '▲', Issue::Tip => '●'];
$issues = static function (array $list, string $ok) use ($e, $icons): void {
	if ([] === $list) {
		echo '<p class="pwa-issue pwa-ok"><b aria-hidden="true">✔</b><span>', $e($ok), '</span></p>';
		return;
	}
	$rank = [Issue::Error => 0, Issue::Warning => 1, Issue::Tip => 2];
	usort($list, static fn (Issue $a, Issue $b): int => $rank[$a->severity] <=> $rank[$b->severity]); // stable
	echo '<ul class="pwa-issues">';
	foreach ($list as $issue) {
		echo '<li class="pwa-issue pwa-', $e($issue->severity), '"><b title="', $e($issue->severity), '">', $icons[$issue->severity], '</b><span>', $e($issue->message), '</span></li>';
	}
	echo '</ul>';
};
?>
